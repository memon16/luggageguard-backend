{
  "name": "luggageguard-backend",
  "version": "1.0.0",
  "description": "LuggageGuard Backend API",
  "scripts": {
    "build": "chmod +x node_modules/.bin/prisma node_modules/.bin/nest && node_modules/.bin/prisma generate && node_modules/.bin/nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@prisma/client": "^5.8.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.9.3",
    "rxjs": "^7.8.1",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.0",
    "prisma": "^5.8.0",
    "typescript": "^5.3.3"
  }
}
